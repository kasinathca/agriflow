# Optional real-data credentials. Demo mode does not require keys.
# data.gov.in key from the OGD portal.
DATA_GOV_API_KEY=
# CEDA Agri Market API bearer token/key. CEDA_API_TOKEN is also accepted.
CEDA_API_KEY=

# App
AGRIFLOW_HOST=127.0.0.1
AGRIFLOW_PORT=8050
AGRIFLOW_DEBUG=0

# Analysis safeguards
AGRIFLOW_MAX_LAG_DAYS=7
AGRIFLOW_MIN_OVERLAP_DAYS=35
AGRIFLOW_MIN_EDGE_CORR=0.30
AGRIFLOW_FDR_ALPHA=0.05
AGRIFLOW_MAX_NETWORK_MARKETS=40
